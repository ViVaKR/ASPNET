<Project>
  <Target Name="PreBuildMessage" BeforeTargets="Build">
    <Message Importance="High"
      Text="⏳ 빌드 시작 시간: $([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss.fff'))" />
  </Target>
  <!-- Build 타겟이 완전히 끝난 직후(AfterTargets="Build")에 작동해라! -->
  <Target Name="EmitCustomMessage" AfterTargets="Build">
    <Message Importance="High" Text="The solution has completed the Build target" />
  </Target>
  <!-- 빌드 완료 후 생성된 DLL의 최종 경로를 출력 -->
  <Target Name="ShowDllPath" AfterTargets="Build">
    <Message Importance="High" Text="📌 생성된 DLL 경로: $(ArtifactsPath)" />
  </Target>


  <Target Name="PostBuildMessage" AfterTargets="Build">
    <Message Importance="High"
      Text="🎉 빌드 완료 시간: $([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss.fff'))" />
  </Target>

</Project>
