{
  "Kestrel": {
    "Endpoints": {
      "Grpc": { "Url": "http://0.0.0.0:8080", "Protocols": "Http2" },
      "Management": { "Url": "http://0.0.0.0:8081", "Protocols": "Http1" }
    },
    "Limits": {
      "Http2": {
        "MaxStreamsPerConnection": 100,
        "KeepAlivePingDelay": "00:00:30",
        "KeepAlivePingTimeout": "00:01:00"
      }
    }
  },
  "Ollama": {
    "BaseUrl": "http://192.168.0.8:11434",
    "RequestTimeoutSeconds": 300
  },
  "Personas": {
    "Beopdeung": {
      "Model": "dhamma-chat:latest",
      "Think": true,
      "SystemPrompt": null
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
